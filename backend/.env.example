# ---------- App ----------
APP_NAME=AI Law Assistant
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Database (PostgreSQL) ----------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_law_assistant

# ---------- JWT Auth ----------
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- AI / LLM ----------
# This project uses Google Gemini via its OpenAI-compatible endpoint by default.
# 1) Get a free Gemini API key: https://aistudio.google.com/apikey
# 2) Paste it below as OPENAI_API_KEY (yes, this variable name — the OpenAI
#    Python SDK is reused to talk to Gemini's compatible endpoint).
# 3) Leave OPENAI_BASE_URL and the model names as-is to use Gemini.
#    To switch to real OpenAI instead: set OPENAI_BASE_URL= (empty),
#    OPENAI_MODEL=gpt-4o-mini, EMBEDDING_MODEL=text-embedding-3-small.
OPENAI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# ---------- File Upload ----------
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
BNS_CSV_PATH=./app/data/bns_sections.csv

# ---------- Admin bootstrap (optional, used by seed script) ----------
FIRST_ADMIN_EMAIL=admin@ailaw.in
FIRST_ADMIN_PASSWORD=ChangeMe123!
